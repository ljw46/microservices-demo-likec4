// SOURCE OF TRUTH: kubernetes-manifests/*.yaml
// Every container/database (and the load generator) must map to a Deployment, and every
// container-to-container relationship to a *_ADDR env var. Component-level relationships
// are lifted to their container. Enforced in CI by likec4/scripts/check-drift.mjs.
// Element id == Deployment name, unless `metadata { deployment '...' }` says otherwise.

model {
  // ---- L1: system context ----
  customer = person 'Customer' {
    description 'Browses and buys products'
  }
  loadgenerator = externalSystem 'Load Generator' {
    description 'Locust traffic simulator'
    technology 'Python/Locust'
    metadata { deployment 'loadgenerator' }
  }

  boutique = softwareSystem 'Online Boutique' {
    description 'Web shop: browse, add to cart, check out'

    // ---- L2: containers ----
    frontend = container 'Frontend' {
      technology 'Go'
      description 'Serves the web UI and calls the backend services'
    }
    cartservice = container 'Cart Service' { technology 'C#' }
    productcatalogservice = container 'Product Catalog Service' { technology 'Go' }
    currencyservice = container 'Currency Service' { technology 'Node.js' }
    paymentservice = container 'Payment Service' { technology 'Node.js' }
    shippingservice = container 'Shipping Service' { technology 'Go' }
    emailservice = container 'Email Service' { technology 'Python' }
    recommendationservice = container 'Recommendation Service' { technology 'Python' }
    adservice = container 'Ad Service' { technology 'Java' }
    rediscart = database 'Cart Store' {
      technology 'Redis'
      metadata { deployment 'redis-cart' }
    }
    shoppingassistantservice = container 'Shopping Assistant Service' {
      #optional
      technology 'Python'
      description 'Optional: kustomize component, not in base manifests'
      style { color red }
    }

    // ---- L3: components of the checkout service (src/checkoutservice/main.go) ----
    checkoutservice = container 'Checkout Service' {
      technology 'Go'
      description 'Orchestrates order placement'

      orderapi = component 'PlaceOrder API' {
        technology 'gRPC handler'
        description 'checkoutService.PlaceOrder'
      }
      cartclient = component 'Cart Access' {
        description 'getUserCart / emptyUserCart'
      }
      itempreparer = component 'Order Item Preparer' {
        description 'prepOrderItems: price lookup and currency conversion'
      }
      shippingquoter = component 'Shipping Quoter' {
        description 'quoteShipping'
      }
      payer = component 'Payment Charger' {
        description 'chargeCard'
      }
      shipper = component 'Order Shipper' {
        description 'shipOrder'
      }
      notifier = component 'Order Notifier' {
        description 'sendOrderConfirmation'
      }

      orderapi -> cartclient 'loads and empties cart'
      orderapi -> itempreparer 'prices items'
      orderapi -> shippingquoter 'quotes shipping'
      orderapi -> payer 'charges card'
      orderapi -> shipper 'ships order'
      orderapi -> notifier 'sends confirmation'

      cartclient -[grpc]-> cartservice
      itempreparer -[grpc]-> productcatalogservice
      itempreparer -[grpc]-> currencyservice
      shippingquoter -[grpc]-> shippingservice
      payer -[grpc]-> paymentservice
      shipper -[grpc]-> shippingservice
      notifier -[grpc]-> emailservice
    }
  }

  // ---- relationships ----
  customer -[http]-> boutique.frontend 'browses and buys'
  loadgenerator -[http]-> boutique.frontend 'generates traffic'

  boutique.frontend -[grpc]-> boutique.productcatalogservice
  boutique.frontend -[grpc]-> boutique.currencyservice
  boutique.frontend -[grpc]-> boutique.cartservice
  boutique.frontend -[grpc]-> boutique.recommendationservice
  boutique.frontend -[grpc]-> boutique.shippingservice
  boutique.frontend -[grpc]-> boutique.checkoutservice
  boutique.frontend -[grpc]-> boutique.adservice
  boutique.frontend -[grpc]-> boutique.shoppingassistantservice { #optional }

  // checkoutservice's outgoing edges are declared at component level (L3) above
  boutique.recommendationservice -[grpc]-> boutique.productcatalogservice
  boutique.cartservice -[tcp]-> boutique.rediscart
}
