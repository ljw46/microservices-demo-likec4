specification {
  element actor {
    style { shape person; color muted }
  }
  element system
  element service {
    notation 'Microservice (Deployment in kubernetes-manifests/)'
    style { shape component; color primary }
  }
  element datastore {
    style { shape cylinder; color amber }
  }

  // not in the base manifests (kustomize component); ignored by drift check
  tag optional

  relationship grpc {
    // no technology: keeps the many gRPC edges free of repeated labels
    line solid
  }
  relationship http {
    technology 'HTTP'
    line dashed
  }
  relationship tcp {
    technology 'TCP'
  }
}
