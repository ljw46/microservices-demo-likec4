// C4 vocabulary: person / softwareSystem (L1), container (L2), component (L3).
specification {
  element person {
    style { shape person; color muted }
  }
  element softwareSystem {
    style { color primary }
  }
  element externalSystem {
    notation 'External / supporting system'
    style { color muted }
  }
  element container {
    notation 'Container: separately deployable (Deployment in kubernetes-manifests/)'
    style { shape rectangle; color primary }
  }
  element database {
    notation 'Container: data store'
    style { shape cylinder; color amber }
  }
  element component {
    notation 'Component: grouping of code inside a container (src/)'
    style { shape rectangle; color sky }
  }

  // not in the base manifests (kustomize component); ignored by drift check
  tag optional

  relationship grpc {
    // no technology: keeps the many gRPC edges free of repeated labels
    line solid
  }
  relationship http {
    technology 'HTTP'
    line dashed
  }
  relationship tcp {
    technology 'TCP'
    line dotted
  }
}
